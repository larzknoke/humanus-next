generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  issuer                String?
  User                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Kurs {
  id            Int          @id @default(autoincrement())
  name          String
  zeitraum      String
  url           String       @unique
  maxTeilnehmer Int
  createdAt     DateTime     @default(now())
  aktiv         Boolean      @default(true)
  beendet       Boolean      @default(false)
  Teilnehmer    Teilnehmer[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Teilnehmer {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  bestaetigt Boolean  @default(false)
  createdAt  DateTime @default(now())
  kursId     Int
  Kurs       Kurs     @relation(fields: [kursId], references: [id], onDelete: Cascade)

  @@index([kursId])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  approved      Boolean   @default(false)
  Account       Account[]
  Session       Session[]
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
}
